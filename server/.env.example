# ── Serveur ─────────────────────────────────────────────────────────────────
PORT=7286
# URL publique de l'application (CORS)
APP_URL=http://localhost:7286
# Derrière un reverse proxy (nginx, Caddy…) : 1 pour que l'IP réelle soit vue (rate-limit)
# TRUST_PROXY=1

# Chiffrement des secrets de double authentification (TOTP) en base : 64 caractères hexadécimaux.
# Générer avec : openssl rand -hex 32   — À CONSERVER : sans cette clé, les comptes ayant la 2FA ne peuvent plus se connecter.
# TOTP_ENCRYPTION_KEY=

# Balayage horaire des fichiers envoyés mais jamais publiés (> 24 h). Mettre « off » pour le désactiver.
# UPLOAD_SWEEP=off

# Démarrer malgré une migration SQL en échec (déconseillé : par défaut le serveur s'arrête).
# MIGRATE_IGNORE_FAILURES=1

# ── MySQL / MariaDB ─────────────────────────────────────────────────────────
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=wouaff

# ── Captcha Cap (auto-hébergé, voir cap/docker-compose.yml) — optionnel ────
# Actif si les trois variables sont définies : inscription, connexion et mot de passe oublié exigent alors le captcha.
# Le navigateur ne contacte jamais Cap directement : le serveur Ministère du vide relaie le défi (/api/captcha).
# CAP_URL=http://127.0.0.1:3001
# CAP_SITE_KEY=
# CAP_SECRET=

# Adresse de contact indiquée aux personnes qui contestent une décision de modération.
# CONTACT_EMAIL=contact@wouaff.app

# ── Notifications push (Web Push / VAPID) — optionnel ──────────────────────
# Sans ces clés, le bouton « Notifications » des paramètres indique que le push n'est pas configuré.
# Générer la paire avec : npm run vapid   (à lancer une fois, puis à CONSERVER : changer les clés
# invalide tous les abonnements existants). La clé privée ne doit jamais être commitée.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Adresse de contact pour les services push (mailto: ou https://). Repli : CONTACT_EMAIL, puis APP_URL si en https.
# VAPID_SUBJECT=mailto:contact@exemple.fr

# ── Messagerie privée ──────────────────────────────────────────────────────
# Chiffrement au repos du contenu des messages (AES-256-GCM) : 64 caractères hexadécimaux.
# Générer avec : openssl rand -hex 32   — À CONSERVER : sans cette clé, les messages chiffrés sont illisibles.
# Sans clé, les messages sont stockés en clair (un avertissement s'affiche au démarrage).
# MESSAGES_ENCRYPTION_KEY=

# ── Référencement : IndexNow (Bing, Yandex…) — optionnel ───────────────────
# Prévient les moteurs dès qu'un post public est publié, modifié ou retiré. Sans clé, rien n'est envoyé.
# 8 à 128 caractères (lettres, chiffres, tirets). Générer avec : openssl rand -hex 16
# Le serveur publie la clé sur /<clé>.txt ; APP_URL doit être l'adresse publique en https.
# INDEXNOW_KEY=

# ── Vues uniques des posts ─────────────────────────────────────────────────
# Clé du HMAC qui rend les adresses IP irréversibles (16 caractères minimum). Générer avec : openssl rand -hex 32
# Sans clé : une clé aléatoire par démarrage est utilisée (un redémarrage permet de recompter un visiteur).
# VIEW_HASH_KEY=
